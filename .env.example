# Template only. Java reads process environment variables; it does not load this file automatically.
# Set these in the backend hosting dashboard, or use a local environment loader.
QUEUE_DB_URL=jdbc:mysql://YOUR_MYSQL_HOST:3306/campus_queue?connectionTimeZone=Asia/Kolkata&sslMode=VERIFY_IDENTITY
QUEUE_DB_USER=YOUR_APPLICATION_DATABASE_USER
QUEUE_DB_PASSWORD=SET_LOCALLY_OR_IN_HOSTING_SECRETS
# Vite development proxy / deployment routing target, not a secret:
QUEUE_BACKEND_URL=http://127.0.0.1:8081
# This project currently needs no third-party API key.
# Never prefix database passwords or private API keys with VITE_.
